target/
dependency-reduced-pom.xml
*.iml
.idea/
.vscode/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Experiments launched from the dashboard (regenerate them from their batch.yaml parameters)
results/dashboard/

# macOS
.DS_Store

# Secrets and credentials: never commit these. AWS credentials belong in ~/.aws (via
# `aws configure --profile ...`), never in this repository.
.env
.env.*
.aws/
credentials
credentials.csv
*_accessKeys.csv
*.pem
*.key
*.p12
*.pfx

# Personal SCALIX settings that should stay on your machine
config/*.local.yaml

# Ad-hoc Python simulator runs (python -m scalix.simulation); the reference run stays committed
results/simulations/sim-*/

# AWS-edition runtime output (access reports, audit logs); may contain masked account details
results/aws/
# Global live-action disable (create with: touch config/LIVE_DISABLED); local state, never committed
config/LIVE_DISABLED

# Large, regenerable experiment outputs (python -m scalix.evaluation run); summaries stay committed
results/experiments/*/timeseries.csv
results/experiments/*/events.csv
results/experiments/*/workloads.csv
